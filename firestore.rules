// ─────────────────────────────────────────────────────────────────────────────
// Snowball — Firestore Security Rules
//
// HOW TO APPLY:
//   Firebase Console → Firestore Database → Rules tab → paste this → Publish
//
// AFTER migration is complete for all existing users:
//   Remove the "Legacy snowball data" block at the bottom.
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Household access is restricted to members listed in memberIds
    match /households/{householdId} {

      function isMember() {
        return request.auth != null &&
          request.auth.uid in resource.data.memberIds;
      }

      function isValidCreate() {
        return request.auth != null &&
          request.auth.uid == request.resource.data.ownerId &&
          request.auth.uid in request.resource.data.memberIds;
      }

      // Joining: only adding self to memberIds, no other field changes
      function isJoining() {
        return request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
          request.auth.uid in request.resource.data.memberIds;
      }

      allow read, delete: if isMember();
      allow create: if isValidCreate();
      allow update: if isMember() || isJoining();

      // Debts, settings, actuals — household members only
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
      }
    }

    // Invite codes — any authenticated user can look one up (to join),
    // only household members can create or delete codes for their household.
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid in
          get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.memberIds;
      allow delete: if request.auth != null &&
        request.auth.uid in
          get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.memberIds;
    }

    // Discount/promo codes — authenticated users can read to check validity.
    // All writes go through the server via Admin SDK (bypasses these rules).
    match /discountCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Share tokens — publicly readable (token is the only key, no PII)
    // Writes go through Admin SDK only.
    match /shareTokens/{token} {
      allow read: if true;
      allow write: if false;
    }

    // Legacy data — any authenticated user can READ for one-time migration.
    // DELETE this block once all households have been migrated.
    match /snowball/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

  }
}
