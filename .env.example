# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values.
# Get these from: Firebase Console → Project Settings → Your Apps

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — server-side only (for webhooks, server routes)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Claude AI Advisor — server-side only, no NEXT_PUBLIC_ prefix
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Stripe Configuration
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Legacy subscription price (keep for existing subscribers)
STRIPE_PRICE_ID=

# One-time $49 advisor unlock price — create in Stripe: Product Catalog → Add product → One-time · $49
STRIPE_ADVISOR_PRICE_ID=

# Your deployed app URL (no trailing slash) — used for Stripe redirect after checkout
# e.g. https://your-app.netlify.app or https://yourdomain.com
NEXT_PUBLIC_APP_URL=

# Admin API — protects the /api/admin/* routes used to create discount/promo codes
# Use any strong random string; keep this secret
ADMIN_API_KEY=

# Optional: override market reference rates shown to the AI for refinancing analysis
# Must be valid JSON — if omitted, built-in defaults are used
# REFINANCING_REFERENCE_RATES={"creditCard":{"low":7.5,"high":12.0,"label":"Personal loan"},...}
